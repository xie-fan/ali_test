# Aliyun DashScope API Key
# Get your API key from: https://help.aliyun.com/zh/model-studio/get-api-key
DASHSCOPE_API_KEY=sk-your-api-key-here

# DashScope API Base URL
# Use for Singapore region: wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
# Use for Beijing region: wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# Qwen Model to use
# Available models: qwen3-asr-flash-realtime, etc.
QWEN_MODEL=qwen3-asr-flash-realtime

# Server listen address
LISTEN_ADDR=localhost:8080
